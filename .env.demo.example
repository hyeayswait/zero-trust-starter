# 本地开发环境变量模板 —— 使用内置轻量服务替代外部依赖
# 用法：复制为 .env.demo 后运行 node scripts/run-demo.mjs
NODE_ENV=development
DEMO_MODE=1
RATE_LIMIT_BACKEND=memory

# 本地演示用固定密钥（勿用于生产！）
APP_SECRET=demo-mode-secret-please-change-32chars-minimum-0001
BASE_URL=http://127.0.0.1:3000

# 本地 mock IdP（scripts/mock-idp.mjs）
OIDC_ISSUER=http://127.0.0.1:8080/.well-known/openid-configuration
OIDC_CLIENT_ID=zt-starter
OIDC_CLIENT_SECRET=zt-secret-1234
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# 本地 mock Ollama（scripts/mock-ollama.mjs）
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
RAG_ENABLED=false

# 无 Postgres：审计走内存缓冲
DATABASE_URL=
