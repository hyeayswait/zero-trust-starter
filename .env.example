# ---- 应用 ----
NODE_ENV=development
APP_SECRET=change-me-to-a-long-random-string-min-32-chars
BASE_URL=http://localhost:3000

# ---- 数据库 (Postgres) ----
# docker compose 内用 db:5432；宿主机直连改成 localhost:5432
DATABASE_URL=postgres://app:app@localhost:5432/zerotrust

# ---- 缓存 / 限流 (Redis) ----
# docker compose 内用 redis:6379；宿主机直连改成 localhost:6379
REDIS_URL=redis://localhost:6379

# 无 Redis 时可设为 memory，改用进程内滑动窗口
# RATE_LIMIT_BACKEND=memory

# ---- OIDC 身份提供商 (零信任核心) ----
OIDC_ISSUER=https://your-oidc-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---- AI 助手 (本地优先 Ollama) ----
# 宿主机安装 Ollama 后默认监听 127.0.0.1:11434；
# 若用 docker compose，服务名是 ollama，改成 http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AI_PROVIDER=ollama
RAG_ENABLED=false

# ---- 可选 ----
# DEMO_MODE=1          跳过 Postgres 写入，审计日志落内存
# NEXT_TELEMETRY_DISABLED=1
