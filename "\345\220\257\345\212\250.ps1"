# 在 PowerShell 里启动本地开发环境
$Root = "D:\deepseek work\zero-trust-starter"
$NodeDir = "D:\deepseek work\tools\node\node-v20.18.1-win-x64"
$env:PATH = "$NodeDir;$env:PATH"
Set-Location $Root

if (-not (Test-Path "$Root\.env.demo")) {
    Copy-Item "$Root\.env.demo.example" "$Root\.env.demo"
    Write-Host "[1/2] 已生成 .env.demo" -ForegroundColor Green
} else {
    Write-Host "[1/2] .env.demo 已存在" -ForegroundColor DarkGray
}

Write-Host "[2/2] 启动服务..." -ForegroundColor Green
Write-Host "  打开浏览器: http://127.0.0.1:3000" -ForegroundColor Cyan
Write-Host "  演示账号:   demo (admin,member)" -ForegroundColor Cyan
Write-Host "  Ctrl+C 停止" -ForegroundColor DarkGray
Write-Host ""

& "$NodeDir\node.exe" "$Root\scripts\run-demo.mjs"
